# ==== 模型接入（必填，任意 OpenAI 兼容端点）====

# 端点地址。示例：
#   小米 mimo:  https://token-plan-cn.xiaomimimo.com/v1
#   智谱:      https://open.bigmodel.cn/api/paas/v4
#   DeepSeek:   https://api.deepseek.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# API key（绝不提交到 git）
OPENAI_API_KEY=

# 模型名。示例：mimo-v2.5-pro / glm-4.6 / deepseek-chat / claude-sonnet-5
MODEL_NAME=

# 厂商协议：openai / anthropic / auto（默认 auto：base_url 含 anthropic 走原生协议，
# 其余一律 OpenAI 兼容协议。Z.AI 的 https://api.z.ai/api/anthropic 用 anthropic）
PROVIDER=auto

# ==== 可选项 ====

# 额外请求体，JSON 字符串。例如 mimo 关闭思考：
# OPENAI_EXTRA_BODY={"thinking": {"type": "disabled"}}
OPENAI_EXTRA_BODY=

# 上下文预算（估算 token 数超过 80% 触发自动压缩，M3 生效）
TOKEN_LIMIT=30000

# 单次任务最大循环轮数（防无限循环）
MAX_TURNS=25

# bash 工具超时秒数（M2 生效）
BASH_TIMEOUT=10
